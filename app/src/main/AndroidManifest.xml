<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" /> <!-- Pour Android 13+ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppBienvenidos"

        android:usesCleartextTraffic="true">
        <activity
            android:name=".view.activities.WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".view.activities.MainActivity" />
        <activity android:name=".view.activities.AddSpot" />
        <activity android:name=".view.activities.SignupActivity" />
        <activity android:name=".view.activities.LoginActivity" />
        <activity android:name=".view.activities.GuideDetailsActivity" />
        <activity android:name=".view.fragments.onboardingActivity" />
        <activity android:name=".view.activities.ParametreActivity" />
        <activity android:name=".view.activities.EditProfileActivity" />
        <activity android:name=".view.activities.FullScreenActivity" />
        <activity android:name=".view.activities.FullMapActivity" />
        <activity
            android:name=".view.activities.SpotDetailActivity"
            android:exported="true"/>

    </application>

</manifest>