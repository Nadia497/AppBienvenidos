<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="@dimen/_16sdp"
    app:cardElevation="@dimen/_1sdp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="@dimen/_12sdp"
        android:orientation="horizontal">

        <!-- Fond de l'icône (Beige clair) -->
        <FrameLayout
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:background="@drawable/circle_background_n"
            android:backgroundTint="@color/background_app"> <!-- Couleur crème plus foncée -->

            <ImageView
                android:id="@+id/rowIcon"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="center"
                android:src="@drawable/outline_person_24"
                app:tint="@color/icon_tint" />
        </FrameLayout>

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_14sdp"
            android:text="Titre Option"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_14sdp"
            android:textStyle="bold" />

        <!-- Texte optionnel à droite (ex: Activées) -->
        <TextView
            android:id="@+id/rowValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12sdp"
            android:layout_marginEnd="8dp"/>

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_chevronright_n"
            app:tint="@color/text_secondary" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>