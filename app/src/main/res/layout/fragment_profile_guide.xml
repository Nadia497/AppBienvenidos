<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="30dp">

        <!-- 1. HEADER COLORÉ  -->
        <View
            android:id="@+id/headerBackground"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/bg_badge_purple_n"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 2. LA CARTE FLOTTANTE -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfileInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="80dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/surface_card"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/background_app"
                android:padding="20dp">

                <!-- Photo -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgProfileGuide"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    tools:src="@tools:sample/avatars"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/surface_card"

                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Nom -->
                <TextView
                    android:id="@+id/GuideName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Nom du Guide"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    app:layout_constraintTop_toBottomOf="@id/imgProfileGuide"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Badge  -->
                <TextView
                    android:id="@+id/txtGuideStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guide Local Certifié"
                    android:textSize="12sp"
                    android:textColor="@color/white_pure"
                    android:background="@color/pink_300"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginTop="5dp"

                    app:layout_constraintTop_toBottomOf="@id/GuideName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- LIGNE D'INFOS (Ville | Prix) -->
                <LinearLayout
                    android:id="@+id/infoRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="15dp"
                    app:layout_constraintTop_toBottomOf="@id/txtGuideStatus">

                    <!-- Ville -->
                    <TextView
                        android:id="@+id/GuideCity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Marrakech"
                        android:textStyle="bold"
                        android:drawablePadding="5dp"
                        app:drawableTint="@color/text_secondary"
                        android:layout_marginEnd="20dp"/>

                    <!-- Séparateur -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="15dp"
                        android:background="@color/text_secondary"
                        android:layout_marginEnd="20dp"/>

                    <!-- Prix -->
                    <TextView
                        android:id="@+id/GuideHourlyRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="250 DH/h"
                        android:textStyle="bold"
                        android:textColor="#4CAF50"
                        android:drawablePadding="5dp"
                        app:drawableTint="#4CAF50"/>
                </LinearLayout>

                <!-- BOUTON APPELER -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCallGuide"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:text="Contacter"
                    android:textStyle="bold"
                    app:cornerRadius="25dp"
                    app:iconGravity="textStart"
                    app:backgroundTint="#4CAF50"

                    app:layout_constraintTop_toBottomOf="@id/infoRow"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- Section Spécialités -->
        <TextView
            android:id="@+id/titleSpecialities"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spécialités et Langues"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="25dp"
            android:layout_marginStart="25dp"
            app:layout_constraintTop_toBottomOf="@id/cardProfileInfo"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/GuideSpecialities"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Cuisine, Souk, Traditions, Histoire..."
            android:layout_marginTop="8dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/titleSpecialities"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/GuideLanguages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Parle : Arabe, Français, Espagnol"
            android:layout_marginTop="5dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:textStyle="italic"
            android:textColor="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/GuideSpecialities"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- Section Spots -->
        <TextView
            android:id="@+id/titleSpots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spots publiés"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="25dp"
            android:layout_marginStart="25dp"
            app:layout_constraintTop_toBottomOf="@id/GuideLanguages"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSpotsGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/titleSpots"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/layoutNoData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/recyclerSpotsGuide"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <ImageView
                android:layout_width="@dimen/_200sdp"
                android:layout_height="@dimen/_200sdp"
                android:src="@drawable/nodata"
                app:tint="@null"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aucun spot publié pour le moment"
                android:textColor="#BDBDBD"
                android:textSize="14sp"
               />


        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>