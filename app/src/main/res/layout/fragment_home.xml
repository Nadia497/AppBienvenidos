<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:fillViewport="true">

    <!-- CONTENU PRINCIPAL (SCROLLABLE) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp">

            <!-- 1. HEADER : Titre + Logo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginBottom="@dimen/_20sdp">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_margin="@dimen/_12sdp"
                    android:src="@drawable/petitlogo" />

                <TextView
                    android:id="@+id/title"
                    style="@style/AppTitleStyle"
                    android:layout_width="140dp"
                    android:layout_height="53dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_gravity="center"
                    android:layout_marginStart="59dp"
                    android:layout_marginTop="11dp"
                    android:layout_marginEnd="70dp"
                    android:layout_marginBottom="11dp"
                    android:layout_toEndOf="@+id/logo"
                    android:gravity="center"
                    android:text="Bienvenidos"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_16sdp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/notif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@color/background_app"
                    app:srcCompat="@drawable/outline_circle_notifications_24"
                    app:tint="@color/icon_tint" />
            </LinearLayout>


            <!-- 2. BARRE DE RECHERCHE -->
            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_search"
                android:backgroundTint="@color/surface_card"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawableEnd="@android:drawable/ic_menu_sort_by_size"
                android:drawablePadding="12dp"
                android:drawableTint="@color/text_secondary"
                android:hint="@string/rechercher_une_ville_un_spot"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <!-- 3. FILTRES (CHIPS) - Scroll Horizontal -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="25dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Chip 1 : Gastronomie (Rose) -->
                    <LinearLayout
                        android:id="@+id/chipTout"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/surface_card"
                        android:gravity="center"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="@color/brand_pink" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/tout"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />-->
                    </LinearLayout>
                    <!--chip café-->
                    <LinearLayout
                        android:id="@+id/chipCafe"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/surface_card"
                        android:gravity="center"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="@color/brand_pink" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/caf"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />-->
                    </LinearLayout>

                    <!-- Chip 2 : Culture (Orange) -->
                    <LinearLayout
                        android:id="@+id/chipCulture"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/surface_card"
                        android:gravity="center"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_agenda"
                            app:tint="@color/brand_yellow" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/culture"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Chip 3 : Nature (Vert) -->
                    <LinearLayout
                        android:id="@+id/chipRestaurant"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/surface_card"
                        android:gravity="center"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_mapmode"
                            app:tint="#66BB6A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/restaurant"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Chip 4 : Événements (Rouge) -->
                    <LinearLayout
                        android:id="@+id/chipShopping"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/surface_card"
                        android:gravity="center"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_today"
                            app:tint="#EF5350" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/shopping"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/chipNature"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/surface_card"
                        android:gravity="center"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_today"
                            app:tint="#EF5350" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Nature"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/chipPayasage"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/surface_card"
                        android:gravity="center"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_today"
                            app:tint="#EF5350" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/paysage"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/chipHotel"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/surface_card"
                        android:gravity="center"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_today"
                            app:tint="#EF5350" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/h_tel"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- 4. SECTION ITINÉRAIRES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="15dp"
                android:text="@string/itin_raires_du_jour"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerItineraries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="25dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="20dp" />
            <!-- SCROLL HORIZONTAL DES CARTES -->


            <!-- 5. SECTION NOUVEAUX SPOTS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:text="@string/nouveaux_spots_proximit"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerNewSpots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="25dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="20dp" />


        </LinearLayout>
    </ScrollView>

    <!-- 6. BARRE DE NAVIGATION EN BAS -->

</androidx.constraintlayout.widget.ConstraintLayout>