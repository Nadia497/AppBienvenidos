<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:fillViewport="true">

    <!-- CONTENU PRINCIPAL (SCROLLABLE) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp">

            <!-- 1. HEADER : Titre + Logo -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="@dimen/_20sdp">

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="55dp"
                    android:layout_height="33dp"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:src="@drawable/petitlogo" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="115dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:layout_gravity="center"
                    android:layout_marginStart="80dp"
                    android:layout_marginEnd="119dp"
                    android:layout_toEndOf="@+id/imageView2"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:text="Bienvenidos"
                    style="@style/AppTitleStyle"
                    android:textColor="@color/black_pure"
                    android:textSize="@dimen/_16sdp"
                    android:textStyle="bold" />

                <ImageButton
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="-10dp"
                    android:layout_marginRight="@dimen/_8sdp"
                    android:backgroundTint="@color/creme_base"
                    android:src="@drawable/ic_more_vert_n" />
            </RelativeLayout>


            <!-- 2. BARRE DE RECHERCHE -->
            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/bg_search"
                android:backgroundTint="@color/surface_card"
                android:hint="Rechercher une ville, un spot..."
                android:textSize="14sp"
                android:textColorHint="@color/text_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawableEnd="@android:drawable/ic_menu_sort_by_size"
                android:drawablePadding="12dp"
                android:drawableTint="@color/text_secondary"
                android:layout_marginBottom="20dp"/>

            <!-- 3. FILTRES (CHIPS) - Scroll Horizontal -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="25dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Chip 1 : Gastronomie (Rose) -->
                    <LinearLayout
                        android:id="@+id/chipTout"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/surface_card"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:layout_marginEnd="10dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="@color/brand_pink"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tout"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginStart="6dp"/>-->
                    </LinearLayout>
                    <!--chip café-->
                    <LinearLayout
                        android:id="@+id/chipCafe"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/surface_card"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:layout_marginEnd="10dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="@color/brand_pink"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Café"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginStart="6dp"/>-->
                    </LinearLayout>

                    <!-- Chip 2 : Culture (Orange) -->
                    <LinearLayout
                        android:id="@+id/chipCulture"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/surface_card"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:layout_marginEnd="10dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_agenda"
                            app:tint="@color/brand_yellow"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Culture"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>

                    <!-- Chip 3 : Nature (Vert) -->
                    <LinearLayout
                        android:id="@+id/chipRestaurant"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/surface_card"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:layout_marginEnd="10dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_mapmode"
                            app:tint="#66BB6A"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Restaurant"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>

                    <!-- Chip 4 : Événements (Rouge) -->
                    <LinearLayout
                        android:id="@+id/chipShopping"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/surface_card"
                        android:gravity="center"
                        android:paddingHorizontal="12dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_today"
                            app:tint="#EF5350"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shopping"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/chipNature"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/surface_card"
                        android:gravity="center"
                        android:paddingHorizontal="12dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_today"
                            app:tint="#EF5350"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nature"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/chipPayasage"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/surface_card"
                        android:gravity="center"
                        android:paddingHorizontal="12dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_today"
                            app:tint="#EF5350"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Payasage"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/chipHotel"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/surface_card"
                        android:gravity="center"
                        android:paddingHorizontal="12dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_today"
                            app:tint="#EF5350"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hotel"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- 4. SECTION ITINÉRAIRES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:text="Itinéraires du Jour"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="15dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerItineraries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:clipToPadding="false"
                android:layout_marginBottom="25dp"/>
            <!-- SCROLL HORIZONTAL DES CARTES -->


            <!-- 5. SECTION NOUVEAUX SPOTS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nouveaux Spots à Proximité"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="15dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerNewSpots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:clipToPadding="false"
                android:layout_marginBottom="25dp"/>
            

        </LinearLayout>
    </ScrollView>

    <!-- 6. BARRE DE NAVIGATION EN BAS -->

</androidx.constraintlayout.widget.ConstraintLayout>