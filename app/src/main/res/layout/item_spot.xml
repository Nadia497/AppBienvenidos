<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context= ".view.activities.SpotDetailActivity"
    android:id="@+id/Spot"
    android:background="#FFF8ED"
    >

    <LinearLayout
        android:id="@+id/LayoutImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        android:layout_marginTop="30dp"
        >

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/FirstImage"
            android:layout_width="120dp"
            android:layout_height="160dp"
            android:layout_margin="5dp"
            android:src="@drawable/image1"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedCorners"

            />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/SecondImage"
            android:layout_width="120dp"
            android:layout_height="160dp"
            android:layout_margin="5dp"
            android:src="@drawable/img2"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedCorners"
            />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ThirdImage"
            android:layout_width="120dp"
            android:layout_height="160dp"
            android:layout_margin="5dp"
            android:src="@drawable/im3"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedCorners"

            />
    </LinearLayout>

    <TextView
        android:id="@+id/NomDuSpot"
        android:text="Spot Name"
        android:textStyle="bold"
        android:textSize="20sp"
        android:fontFamily="sans-serif"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/LayoutImage"
        android:layout_marginTop="15dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="#000000"
        ></TextView>

    <TextView
        android:id="@+id/SmallDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/NomDuSpot"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        android:text="Description courte"
        android:textColor="#8E8E8E"
        android:fontFamily="serif"
        >
    </TextView>

    <RatingBar
        android:id="@+id/ratingbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="1"
        app:layout_constraintTop_toBottomOf="@id/SmallDescription"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="40dp"
        android:layout_marginTop="15dp"
        android:rating="0"
        android:isIndicator="false"
        style="?android:attr/ratingBarStyleSmall"
        android:scaleX="1.5"
        android:scaleY="1.5"
        android:progressTint="@color/Gold"
        ></RatingBar>


    <TextView
        android:id="@+id/InfoDuSpot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/ratingbar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:text="User and Publication date"
        android:layout_marginTop="15dp"
        android:textColor="#8E8E8E"
        android:fontFamily="serif"
        ></TextView>

    <TextView
        android:id="@+id/textviewaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/InfoDuSpot"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:text="Actions :"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:layout_marginTop="15dp"
        android:textColor="#000000"
        ></TextView>

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/textviewaction"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="5dp"
        >

        <com.google.android.material.button.MaterialButton
            android:id="@+id/AskUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:padding="5dp"
            android:text="Poser une question au local"
            android:textSize="15dp"
            android:translationZ="8dp"
            app:backgroundTint="#FBC02D"
            app:cornerRadius="8dp"
            app:elevation="18dp"
            android:layout_margin="5dp"
            app:icon="@drawable/chaticon"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/Share"
            android:text=" Partager"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15dp"
            android:fontFamily="serif"
            android:textColor="#000000"
            app:elevation="18dp"
            android:translationZ="8dp"
            app:backgroundTint="#FFFF"
            app:cornerRadius="8dp"
            android:layout_margin="5dp"
            app:icon="@drawable/sharethis"
            />

    </LinearLayout>

    <TextView
        android:id="@+id/textviewDescriptionwithdetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/actions"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="15dp"
        android:layout_marginStart="20dp"
        android:text="Description Détaillée :"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:textSize="16sp"
        android:textColor="#000000"
        ></TextView>

    <TextView
        android:id="@+id/Descriptionwithdetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/textviewDescriptionwithdetails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text="Cet endroit est ldnh hdsiofze siy cdbjhcija zdugziuhoi Cet endroit est ldnh hdsiofze siy cdbjhcija zdugziuhoi Cet endroit est ldnh hdsiofze siy cdbjhcija zdugziuhoi"
        android:textColor="#8E8E8E"
        android:fontFamily="serif"
        android:textSize="14sp"
        ></TextView>

    <TextView
        android:id="@+id/Informationspratique"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/Descriptionwithdetails"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        android:textSize="16sp"
        android:text="Informations pratique :"
        android:textColor="#000000"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        ></TextView>

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="200dp"
        android:layout_height="150dp"
        app:layout_constraintTop_toBottomOf="@id/Informationspratique"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="15dp" />

    <LinearLayout
        android:id="@+id/layoutInfosMap"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/Informationspratique"
        app:layout_constraintBottom_toBottomOf="@id/map"
        app:layout_constraintStart_toEndOf="@id/map"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="20dp">

        <TextView
            android:id="@+id/infoAdresse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adresse : "
            android:textColor="#8E8E8E"
            android:textSize="12sp"
            android:fontFamily="serif"

            />

        <TextView
            android:id="@+id/infoHeures"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Horraires: "
            android:textColor="#8E8E8E"
            android:textSize="12sp"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/infoContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prix : "
            android:textColor="#8E8E8E"
            android:textSize="12sp"
            android:fontFamily="serif" />

    </LinearLayout>









</androidx.constraintlayout.widget.ConstraintLayout>