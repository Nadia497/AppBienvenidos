<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/creme_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingTop="40dp"
        android:paddingBottom="40dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- HEADER LOGO & TITRE -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="90dp"
            android:layout_height="98dp"
            android:src="@drawable/petitlogo"/>

        <TextView
            android:id="@+id/Bienvenidos"
            style="@style/AppTitleStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/pacifico"
            android:shadowColor="#55000000"
            android:textColor="#FBC02D"
            android:text="Bienvenidos"
            android:textSize="35sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="cursive"
            android:text="Le monde à portée de main"
            android:textColor="#E996C4"
            android:textSize="20sp" />

        <!-- ZONE PHOTO DE PROFIL CIRCULAIRE -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="15dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardProfile"
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:cardCornerRadius="60dp"
                app:cardElevation="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/user_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/outline_person_24"
                    android:background="#F5F5F5"
                    android:padding="25dp"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/circle_border"
                    />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnChangePhoto"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="#FBC02D"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toBottomOf="@id/cardProfile"
                app:layout_constraintEnd_toEndOf="@id/cardProfile">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#FFFFFF"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajouter une photo"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/cardProfile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- CONTENEUR FORMULAIRE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            android:orientation="vertical">

            <!-- NOM / PRENOM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="Nom"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:paddingStart="5dp"
                    android:text="Prénom"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:orientation="horizontal">

                <!-- Champ NOM avec icône -->
                <EditText
                    android:id="@+id/editTextFirstName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="50dp"
                    android:background="@drawable/edittext_singup"
                    android:layout_marginEnd="5dp"
                    android:padding="10dp"
                    android:drawableStart="@drawable/outline_person_24"
                    android:drawablePadding="8dp"
                    android:drawableTint="#AAAAAA"
                    android:inputType="textPersonName"
                    android:hint="Nom"/>

                <!-- Champ PRENOM avec icône -->
                <EditText
                    android:id="@+id/editTextLastName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="50dp"
                    android:background="@drawable/edittext_singup"
                    android:layout_marginStart="5dp"
                    android:padding="10dp"
                    android:drawableStart="@drawable/outline_person_24"
                    android:drawablePadding="8dp"
                    android:drawableTint="#AAAAAA"
                    android:inputType="textPersonName"
                    android:hint="Prénom"/>
            </LinearLayout>

            <!-- EMAIL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="Email" />

            <!-- Champ EMAIL avec icône système -->
            <EditText
                android:id="@+id/editTextEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/edittext_singup"
                android:layout_marginBottom="15dp"
                android:padding="10dp"
                android:drawableStart="@android:drawable/ic_dialog_email"
                android:drawablePadding="10dp"
                android:drawableTint="#AAAAAA"
                android:inputType="textEmailAddress"
                android:hint="exemple@email.com"/>

            <!-- LOCATION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="Location" />

            <!-- Champ LOCATION avec icône MAP -->
            <EditText
                android:id="@+id/editTextLocation"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/edittext_singup"
                android:layout_marginBottom="15dp"
                android:padding="10dp"
                android:drawableStart="@android:drawable/ic_dialog_map"
                android:drawablePadding="10dp"
                android:drawableTint="#AAAAAA"
                android:inputType="textPostalAddress"
                android:hint="Ville, Pays"/>

            <!-- MOT DE PASSE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="Mot de passe" />

            <!-- Champ PASSWORD avec icône LOCK -->
            <EditText
                android:id="@+id/editTextPasswordHash"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/edittext_singup"
                android:layout_marginBottom="20dp"
                android:padding="10dp"
                android:drawableStart="@android:drawable/ic_lock_idle_lock"
                android:drawablePadding="10dp"
                android:drawableTint="#AAAAAA"
                android:inputType="textPassword"
                android:hint="••••••••"/>

            <!-- ROLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="Rôle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/rounded_corners"
                android:padding="4dp"
                android:layout_marginBottom="25dp">

                <Button
                    android:id="@+id/roleTraveler"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="45dp"
                    android:backgroundTint="@android:color/transparent"
                    android:text="Voyageur"
                    android:textColor="#000000"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/roleLocal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="45dp"
                    android:text="Local"
                    android:textSize="14sp"
                    android:textColor="#F8AFCB"
                    android:backgroundTint="@color/creme_background"
                    app:cornerRadius="8dp"/>
            </LinearLayout>

            <!-- BOUTON S'INSCRIRE -->
            <Button
                android:id="@+id/Sinscrire"
                android:text="S'inscrire"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                app:elevation="10dp"
                app:backgroundTint="#FBC02D"
                app:cornerRadius="12dp"/>

            <!-- LIEN CONNEXION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/alreadyRegistred"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#666666"
                    android:text="As-tu déjà un compte ? "/>

                <TextView
                    android:id="@+id/SeConnecter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="#FBC02D"
                    android:padding="5dp"
                    android:text="Se connecter"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>