<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/creme_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:paddingTop="40dp"
        android:paddingBottom="40dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- HEADER LOGO & TITRE -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="90dp"
            android:layout_height="98dp"
            android:src="@drawable/petitlogo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/Bienvenidos"
            style="@style/AppTitleStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/pacifico"
            android:shadowColor="#55000000"
            android:textColor="#FBC02D"
            android:text="Bienvenidos"
            android:textSize="35sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logo"/>

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="cursive"
            android:text="Le monde à portée de main"
            android:textColor="#E996C4"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/Bienvenidos"/>

        <!-- ZONE PHOTO DE PROFIL CIRCULAIRE -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/subtitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="20dp">
                    <!-- NOUVEAU BLOC PHOTO CORRIGÉ -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="20dp">

                        <!-- 2. La CardView qui coupe la photo en rond (Masque) -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardPhotoContainer"
                            android:layout_width="105dp"
                            android:layout_height="105dp"
                            app:cardCornerRadius="52.5dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <!-- 1. Le cercle (pointillé ou bordure) en arrière-plan -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/circle_border" />
                            <ImageView
                                android:id="@+id/user_photo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/outline_person_24"
                                android:padding="25dp" />
                        </androidx.cardview.widget.CardView>

                        <!-- 3. Le bouton Caméra -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnChangePhoto"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardCornerRadius="16dp"
                            app:cardBackgroundColor="#FBC02D"
                            app:cardElevation="6dp"
                            android:layout_marginEnd="4dp"
                            android:layout_marginBottom="4dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_camera"
                                app:tint="#FFFFFF"/>
                        </androidx.cardview.widget.CardView>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>


            <!--<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajouter une photo"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/cardProfile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>-->
            <!-- CONTENEUR FORMULAIRE -->
                <!-- NOM / PRENOM -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15dp"
                    android:orientation="horizontal">

                <!-- Champ NOM avec icône -->
                <EditText
                    android:id="@+id/editTextFirstName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="50dp"
                    android:background="@drawable/edittext_singup"
                    android:layout_marginEnd="5dp"
                    android:padding="10dp"
                    android:drawableStart="@drawable/outline_person_24"
                    android:drawablePadding="@dimen/_8sdp"
                    android:drawableTint="#AAAAAA"
                    android:inputType="textPersonName"
                    android:hint="Nom"
                    android:textSize="@dimen/_13sdp"/>

                <!-- Champ PRENOM avec icône -->
                <EditText
                    android:id="@+id/editTextLastName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="50dp"
                    android:background="@drawable/edittext_singup"
                    android:layout_marginStart="5dp"
                    android:padding="10dp"
                    android:drawableStart="@drawable/outline_person_24"
                    android:drawablePadding="8dp"
                    android:drawableTint="#AAAAAA"
                    android:inputType="textPersonName"
                    android:hint="Prénom"
                    android:textSize="@dimen/_13sdp"/>
            </LinearLayout>

            <!-- EMAIL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="Email" />

            <!-- Champ EMAIL avec icône système -->
            <EditText
                android:id="@+id/editTextEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/edittext_singup"
                android:layout_marginBottom="15dp"
                android:padding="10dp"
                android:drawableStart="@android:drawable/ic_dialog_email"
                android:drawablePadding="10dp"
                android:drawableTint="#AAAAAA"
                android:inputType="textEmailAddress"
                android:hint="exemple@email.com"
                android:textSize="@dimen/_13sdp"/>

            <!-- LOCATION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="Location" />

            <!-- Champ LOCATION avec icône MAP -->
            <EditText
                android:id="@+id/editTextLocation"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/edittext_singup"
                android:layout_marginBottom="15dp"
                android:padding="10dp"
                android:drawableStart="@drawable/ic_location_n"
                android:drawablePadding="10dp"
                android:drawableTint="#AAAAAA"
                android:inputType="textPostalAddress"
                android:hint="Ville, Pays"
                android:textSize="@dimen/_13sdp"/>

            <!-- MOT DE PASSE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="Mot de passe" />

            <!-- Champ PASSWORD avec icône LOCK -->
            <EditText
                android:id="@+id/editTextPasswordHash"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/edittext_singup"
                android:layout_marginBottom="20dp"
                android:padding="10dp"
                android:drawableStart="@android:drawable/ic_lock_idle_lock"
                android:drawablePadding="10dp"
                android:drawableTint="#AAAAAA"
                android:inputType="textPassword"
                android:hint="••••••••"/>

            <!-- ROLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="Rôle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/rounded_corners"
                android:padding="4dp"
                android:layout_marginBottom="25dp">

                <Button
                    android:id="@+id/roleTraveler"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="45dp"
                    android:backgroundTint="@android:color/transparent"
                    android:text="Voyageur"
                    android:textColor="#000000"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/roleLocal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="45dp"
                    android:text="Local"
                    android:textSize="14sp"
                    android:textColor="#F8AFCB"
                    android:backgroundTint="@color/creme_background"
                    app:cornerRadius="8dp"/>
            </LinearLayout>

            <!-- BOUTON S'INSCRIRE -->
            <Button
                android:id="@+id/Sinscrire"
                android:text="S'inscrire"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                app:elevation="10dp"
                app:backgroundTint="#FBC02D"
                app:cornerRadius="12dp"/>

            <!-- LIEN CONNEXION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/alreadyRegistred"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#666666"
                    android:text="As-tu déjà un compte ? "/>

                <TextView
                    android:id="@+id/SeConnecter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="#FBC02D"
                    android:padding="5dp"
                    android:text="Se connecter"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>